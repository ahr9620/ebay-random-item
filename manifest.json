{
  "manifest_version": 3,
  "name": "eBay Random Item Finder",
  "version": "1.0",
  "description": "Find random eBay items within your budget",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://svcs.ebay.com/*",
    "https://www.ebay.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}


